{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!playwright-report",
      "!test-results",
      "!**/*.snap",
      // hand-maintained bibliography and upstream research data: byte-for-byte
      // stability matters more than formatting, and `bun run generate` reads them
      "!docs/*.json",
      // generated by `scripts/generate-catalog.mjs` for consumers outside this repository, and
      // diffed by CI. Formatting it here would make the generator and the formatter disagree on
      // every run, which is the same trap `#[rustfmt::skip]` solves on the Rust side
      "!data/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "quoteProperties": "asNeeded"
    }
  },
  "css": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    // named rather than inferred from package.json, so the React and test rules cannot
    // silently switch off if a dependency is hoisted or renamed
    "domains": { "react": "recommended", "test": "recommended" },
    "rules": {
      "preset": "recommended",
      // the point of this config: every a11y rule Biome ships, none excepted
      "a11y": { "preset": "all" },
      "correctness": {
        "preset": "recommended",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useJsxKeyInIterable": "error"
      },
      "suspicious": {
        "preset": "recommended",
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noVar": "error",
        "noSkippedTests": "error",
        "noFocusedTests": "error",
        "noDuplicateTestHooks": "error",
        "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } }
      },
      "style": {
        "preset": "recommended",
        // architectural boundaries, mirrored per-layer in `overrides` below
        "noRestrictedImports": "off",
        // tsconfig sets noUncheckedIndexedAccess, which makes `arr[i]!` the deliberate,
        // reviewed way to assert a bound the compiler cannot see. Banning it would push
        // the codebase towards `as` casts, which are strictly weaker
        "noNonNullAssertion": "off",
        // the Biome counterpart of eslint-plugin-react-refresh: a module that exports a component
        // and something else breaks fast refresh. allowConstantExport matches that plugin's Vite
        // preset
        "useComponentExportOnlyModules": {
          "level": "error",
          "options": { "allowConstantExport": true }
        }
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "overrides": [
    {
      "includes": ["tsconfig*.json", ".vscode/*.json"],
      "json": { "parser": { "allowComments": true } }
    },
    {
      "includes": ["src/sim/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "three",
                      "three/**",
                      "three-*",
                      "@react-three/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "zustand",
                      "zustand/**"
                    ],
                    "message": "src/sim is framework-free by architectural rule: no three.js, no React, no store. See docs/ARCHITECTURE.md"
                  },
                  {
                    "group": [
                      "@/scene",
                      "@/scene/**",
                      "@/ui",
                      "@/ui/**",
                      "@/state",
                      "@/state/**",
                      "@/data",
                      "@/data/**",
                      "@/recommend",
                      "@/recommend/**",
                      "../scene/**",
                      "../ui/**",
                      "../state/**",
                      "../data/**",
                      "../recommend/**",
                      "../../scene/**",
                      "../../ui/**",
                      "../../state/**",
                      "../../data/**",
                      "../../recommend/**"
                    ],
                    "message": "src/sim may not import upstream layers. Dependencies flow types -> sim -> data -> recommend -> state -> scene/ui"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/types/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "three",
                      "three/**",
                      "three-*",
                      "@react-three/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "zustand",
                      "zustand/**",
                      "@/**",
                      "../**"
                    ],
                    "message": "src/types is a leaf module and may only import from src/types"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // src/agent sits between state and ui: it may read the store and every layer below it, and
      // may not reach into the renderer or the panels. What keeps it honest is that the whole
      // router has to stay testable with no DOM, no GL and no React, the same way src/sim does
      "includes": ["src/agent/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "three",
                      "three/**",
                      "three-*",
                      "@react-three/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "@/scene",
                      "@/scene/**",
                      "@/ui",
                      "@/ui/**",
                      "../scene/**",
                      "../ui/**"
                    ],
                    "message": "src/agent may not import the renderer or the panels. Dependencies flow types -> sim -> data -> recommend -> state -> agent -> scene/ui"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // src/simulation runs the garden forward a season at a time. It sits between recommend and
      // state: pure, no store, no DOM, no GL, so a season is a value in and a report out and the
      // whole of it is testable the way src/sim and src/recommend are (Decision Record 14)
      "includes": ["src/simulation/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "three",
                      "three/**",
                      "three-*",
                      "@react-three/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "zustand",
                      "zustand/**",
                      "@/state",
                      "@/state/**",
                      "@/agent",
                      "@/agent/**",
                      "@/scene",
                      "@/scene/**",
                      "@/ui",
                      "@/ui/**",
                      "../state/**",
                      "../agent/**",
                      "../scene/**",
                      "../ui/**"
                    ],
                    "message": "src/simulation is pure and may import only types, sim, data and recommend. Dependencies flow types -> sim -> data -> recommend -> simulation -> state -> agent -> scene/ui"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["workers/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "three",
                      "three/**",
                      "three-*",
                      "@react-three/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "zustand",
                      "zustand/**",
                      "../../src/**",
                      "@/**"
                    ],
                    "message": "The edge proxy is standalone and must not pull in browser application code"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "src/**/testkit.ts", "scripts/**", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          // fast refresh does not apply to a test module
          "style": { "useComponentExportOnlyModules": "off" }
        }
      }
    },
    {
      // react-three-fiber intrinsics (<mesh>, <group>, <line>) are three.js objects, not DOM
      // nodes. Biome's element-shaped a11y rules read `onClick` on them as an unlabelled DOM
      // handler and cannot be satisfied: a <mesh> takes no role, no tabindex and no key event.
      // Every scene interaction has a keyboard-reachable DOM equivalent in src/ui
      "includes": ["src/scene/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off",
            "noNoninteractiveElementInteractions": "off"
          }
        }
      }
    },
    {
      // Coefficient tables transcribed from a published source, here the Perez 1993 table in
      // `perez-tables.ts`. A term that sits near a standard constant must stay at the published
      // precision, so substituting a `Math` constant would silently change the model
      "includes": ["src/sim/*-tables.ts"],
      "linter": { "rules": { "suspicious": { "noApproximativeNumericConstant": "off" } } }
    },
    {
      // src/sim is React-free by architectural rule, so nothing here can be a hook. The rule only
      // fires on WebGL's gl.useProgram, which it mistakes for one
      "includes": ["src/sim/**"],
      "linter": { "rules": { "correctness": { "useHookAtTopLevel": "off" } } }
    }
  ]
}
