{
  "name": "agrivoltaic-garden-designer",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.2",
    "node": ">=20"
  },
  "scripts": {
    "preinstall": "node scripts/only-bun.mjs",
    "dev": "VITE_AGENT=${VITE_AGENT:-off} vite",
    "build": "bun run rust:wasm && tsc -b && vite build && node scripts/render-docs.mjs",
    "preview": "vite preview",
    "test": "bun run rust:wasm && bun run test:dom && bun run test:scene",
    "test:dom": "bun test src/ workers/ --parallel --preload ./test/dom.ts --path-ignore-patterns='**/scene/*.test.tsx'",
    "test:scene": "bun test src/scene/*.test.tsx --parallel",
    "test:watch": "bun test --watch src/ workers/ --preload ./test/dom.ts --path-ignore-patterns='**/scene/*.test.tsx'",
    "test:e2e": "playwright test",
    "read-session": "READ_SESSION=on playwright test e2e/read-session.spec.ts --project=functional --reporter=line",
    "lint": "biome lint . && eslint .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "generate": "node scripts/generate-citations.mjs && node scripts/render-citations-md.mjs && node scripts/generate-rust-tables.mjs && node scripts/generate-catalog.mjs",
    "check": "biome check --write .",
    "dev:worker": "wrangler dev",
    "preview:worker": "bun run build:deploy && wrangler dev --env production",
    "build:deploy": "bun run fetch-agent-model && bun run typecheck && bun run lint && REQUIRE_AGENT_MODEL=1 bun run test && bun run build",
    "deploy": "bun run build:deploy && wrangler deploy --env production",
    "verify-deploy": "node scripts/verify-deploy.mjs",
    "rust:test": "cargo test --manifest-path crates/agv-sim/Cargo.toml",
    "rust:wasm": "cargo build --release --manifest-path crates/agv-sim/Cargo.toml --target wasm32-unknown-unknown && bun run rust:ship",
    "rust:ship": "cp crates/agv-sim/target/wasm32-unknown-unknown/release/agv_sim.wasm public/agv-sim.wasm",
    "rust:fmt": "cargo fmt --manifest-path crates/agv-sim/Cargo.toml --check && cargo clippy --manifest-path crates/agv-sim/Cargo.toml --all-targets -- -D warnings",
    "secret:nsrdb": "wrangler secret put NSRDB_API_KEY --env production",
    "secret:nsrdb-email": "wrangler secret put NSRDB_EMAIL --env production",
    "secret:eia": "wrangler secret put EIA_API_KEY --env production",
    "tail": "wrangler tail --env production",
    "rollback": "wrangler rollback --env production",
    "fetch-layers": "node --max-old-space-size=12288 scripts/fetch-static-layers.mjs",
    "fetch-agent-model": "node scripts/fetch-agent-model.mjs",
    "bake-example": "node scripts/bake-example-garden.mjs",
    "demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "immer": "11.1.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "suncalc": "2.0.1",
    "three": "0.185.1",
    "three-bvh-csg": "0.0.18",
    "three-mesh-bvh": "0.9.13",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.0",
    "@react-three/test-renderer": "^9.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.13.0",
    "bun-types": "^1.4.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "marked": "^18.0.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "playwright-core": "1.62.0"
  }
}
